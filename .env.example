# Broker
COCO_BROKER=rabbit
RABBIT_URL=amqp://cocomarket:change-me-before-production@rabbitmq:5672/%2F
COCO_RABBIT_QUEUE_PREFIX=cocomarket.v2
RABBITMQ_USER=cocomarket
RABBITMQ_PASSWORD=change-me-before-production

# Sécurité
COCO_ENV=production
COCO_SECRET=change-me-with-a-random-secret
COCO_BOOTSTRAP_ADMIN_PASSWORD=change-me-with-a-long-admin-password
COCO_SEED_DEMO_USERS=0
COCO_HTTPS=0

# Données et exécution
COCO_DATA=/app/data
COCO_WORKERS=0
COCO_COMPONENT=web
COCO_RETRY_DELAY=3
COCO_MAX_RETRIES=3
COCO_LINK_MODE=auto
DATABASE_URL=postgresql://cocomarket:change-me-before-production@localhost:5432/cocomarket
POSTGRES_PASSWORD=change-me-before-production
